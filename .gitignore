# Build output
/noisecrypt
/noisecrypt.exe
/dist/
/build/
# Short names used when building a throwaway binary to try something by hand. Listed
# rather than deleted each time: remembering to clean up is not a strategy.
/nc
/nc.exe
/gui.log

# Test and scratch artefacts
*.mp4
# Payloads and videos for a platform round trip. The .mp4 rule already covers the videos;
# this covers the payload beside them, which has no extension anyone would guess.
/.tiktok/
*.ncry
*.test
/testdata/tmp/
coverage.out

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Never commit key material
*.key
*.pem
*.p8
*.p12
.env
.env.*
!.env.example
